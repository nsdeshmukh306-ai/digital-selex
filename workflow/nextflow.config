/*
 * digital_selex — Nextflow configuration
 * Tested with Nextflow 23.04+
 */

manifest {
    name        = "digital_selex"
    description = "In-silico digital SELEX for TCA cycle metabolite aptamers"
    version     = "1.0.0"
    author      = "digital_selex pipeline"
}

params {
    // ── SELEX parameters ───────────────────────────────────────────────
    rounds             = 3
    initial_pool_size  = 50
    seq_length_min     = 30
    seq_length_max     = 50
    gc_min             = 0.40
    gc_max             = 0.60
    mutation_rate      = 0.10
    random_fraction    = 0.20
    selection_fraction = 0.30
    seed               = 42

    // ── Docking parameters ────────────────────────────────────────────
    exhaustiveness     = 4
    num_modes          = 5
    box_size           = 20
    docking_cpu        = 2

    // ── Paths ─────────────────────────────────────────────────────────
    config_file        = "${projectDir}/../config/config.yaml"
    targets_file       = "${projectDir}/../config/targets.yaml"
    scripts_dir        = "${projectDir}/../scripts"
    outdir             = "${projectDir}/../results"
}

process {
    // Default: single core, 4 GB RAM
    cpus   = 1
    memory = "4 GB"
    time   = "2h"

    withName: "RUN_DOCKING" {
        cpus   = params.docking_cpu
        memory = "8 GB"
        time   = "4h"
    }

    withName: "TRAIN_MODEL" {
        cpus   = 2
        memory = "8 GB"
        time   = "1h"
    }
}

executor {
    name    = "local"
    cpus    = 4
    memory  = "16 GB"
}

report {
    enabled   = true
    file      = "${params.outdir}/nextflow_report.html"
    overwrite = true
}

timeline {
    enabled   = true
    file      = "${params.outdir}/nextflow_timeline.html"
    overwrite = true
}
